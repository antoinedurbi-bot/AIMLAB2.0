[gd_scene format=3]

[ext_resource type="Script" path="res://ui/stats_dashboard.gd" id="1_dashboard"]
[ext_resource type="Script" path="res://ui/flick_bar.gd" id="2_flick_bar"]
[ext_resource type="Script" path="res://ui/heatmap.gd" id="3_heatmap"]
[ext_resource type="Script" path="res://ui/bar_chart.gd" id="4_bar_chart"]

[node name="StatsDashboard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dashboard")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.012, 0.02, 0.035, 0.92)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 26
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 22

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2

[node name="TitleBox" type="VBoxContainer" parent="Margin/Root/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Margin/Root/Header/TitleBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 40
text = "RAPPORT DE SESSION"

[node name="Subtitle" type="Label" parent="Margin/Root/Header/TitleBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "EXERCICE"

[node name="ScoreBox" type="VBoxContainer" parent="Margin/Root/Header"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="ScoreValue" type="Label" parent="Margin/Root/Header/ScoreBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0, 0.9, 1, 1)
theme_override_font_sizes/font_size = 52
text = "0"
horizontal_alignment = 2

[node name="ScoreTrend" type="Label" parent="Margin/Root/Header/ScoreBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "SCORE"
horizontal_alignment = 2

[node name="CoachPanel" type="PanelContainer" parent="Margin/Root"]
layout_mode = 2
theme_type_variation = &"CoachPanel"

[node name="CoachBox" type="VBoxContainer" parent="Margin/Root/CoachPanel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CoachCaption" type="Label" parent="Margin/Root/CoachPanel/CoachBox"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "CONSEIL DU COACH"

[node name="CoachTitle" type="Label" parent="Margin/Root/CoachPanel/CoachBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ValueLabel"
theme_override_font_sizes/font_size = 26
text = "—"

[node name="FactRow" type="HBoxContainer" parent="Margin/Root/CoachPanel/CoachBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="FactTag" type="Label" parent="Margin/Root/CoachPanel/CoachBox/FactRow"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"CaptionLabel"
text = "CONSTAT"

[node name="CoachText" type="Label" parent="Margin/Root/CoachPanel/CoachBox/FactRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "—"
autowrap_mode = 3

[node name="ActionRow" type="HBoxContainer" parent="Margin/Root/CoachPanel/CoachBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="ActionTag" type="Label" parent="Margin/Root/CoachPanel/CoachBox/ActionRow"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"CaptionLabel"
theme_override_colors/font_color = Color(0, 0.9, 1, 1)
text = "À FAIRE"

[node name="CoachAction" type="Label" parent="Margin/Root/CoachPanel/CoachBox/ActionRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 1, 1, 1)
text = "—"
autowrap_mode = 3

[node name="CoachCards" type="HBoxContainer" parent="Margin/Root/CoachPanel/CoachBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="KpiGrid" type="GridContainer" parent="Margin/Root"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
columns = 4

[node name="Analysis" type="HBoxContainer" parent="Margin/Root"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="ChartPanel" type="PanelContainer" parent="Margin/Root/Analysis"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Chart" type="Control" parent="Margin/Root/Analysis/ChartPanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 180)
layout_mode = 2
script = ExtResource("4_bar_chart")

[node name="FlickPanel" type="PanelContainer" parent="Margin/Root/Analysis"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="FlickBox" type="VBoxContainer" parent="Margin/Root/Analysis/FlickPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FlickTitle" type="Label" parent="Margin/Root/Analysis/FlickPanel/FlickBox"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "FLICKS · OVERFLICK / UNDERFLICK"

[node name="FlickBar" type="Control" parent="Margin/Root/Analysis/FlickPanel/FlickBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
script = ExtResource("2_flick_bar")

[node name="FlickDetails" type="Label" parent="Margin/Root/Analysis/FlickPanel/FlickBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "—"
autowrap_mode = 3

[node name="SmoothHeader" type="HBoxContainer" parent="Margin/Root/Analysis/FlickPanel/FlickBox"]
layout_mode = 2

[node name="SmoothTitle" type="Label" parent="Margin/Root/Analysis/FlickPanel/FlickBox/SmoothHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionLabel"
text = "INDICE DE FLUIDITÉ"

[node name="SmoothValue" type="Label" parent="Margin/Root/Analysis/FlickPanel/FlickBox/SmoothHeader"]
unique_name_in_owner = true
layout_mode = 2
