[node name="HeatLegend" type="Label" parent="Margin/Root/Analysis/HeatPanel/HeatBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "—"
autowrap_mode = 3

[node name="DataPanel" type="PanelContainer" parent="Margin/Root"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="DataBox" type="VBoxContainer" parent="Margin/Root/DataPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DataTitle" type="Label" parent="Margin/Root/DataPanel/DataBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "TOUTES LES DONNÉES DE LA SESSION"

[node name="DataScroll" type="ScrollContainer" parent="Margin/Root/DataPanel/DataBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="DataGrid" type="GridContainer" parent="Margin/Root/DataPanel/DataBox/DataScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 4
columns = 6

[node name="Footer" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="FooterInfo" type="Label" parent="Margin/Root/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CaptionLabel"
text = "Télémétrie"
vertical_alignment = 1
clip_text = true

[node name="DataButton" type="Button" parent="Margin/Root/Footer"]
unique_name_in_owner = true
layout_mode = 2
