[gd_scene format=3]

[ext_resource type="Script" path="res://ui/stats_dashboard.gd" id="1_dashboard"]
[ext_resource type="Script" path="res://ui/flick_bar.gd" id="2_flick_bar"]
[ext_resource type="Script" path="res://ui/heatmap.gd" id="3_heatmap"]

[node name="StatsDashboard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dashboard")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.012, 0.02, 0.035, 0.9)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 56
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 32

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2

[node name="TitleBox" type="VBoxContainer" parent="Margin/Root/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Margin/Root/Header/TitleBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 46
text = "RAPPORT DE SESSION"

[node name="Subtitle" type="Label" parent="Margin/Root/Header/TitleBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "GRIDSHOT · 60 s"

[node name="ScoreBox" type="VBoxContainer" parent="Margin/Root/Header"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="ScoreCaption" type="Label" parent="Margin/Root/Header/ScoreBox"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "SCORE TOTAL"
horizontal_alignment = 2

[node name="ScoreValue" type="Label" parent="Margin/Root/Header/ScoreBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(0, 0.9, 1, 1)
theme_override_font_sizes/font_size = 60
text = "0"
horizontal_alignment = 2

[node name="Body" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 18

[node name="LeftColumn" type="VBoxContainer" parent="Margin/Root/Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.3
theme_override_constants/separation = 16

[node name="KpiGrid" type="GridContainer" parent="Margin/Root/Body/LeftColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
columns = 3

[node name="FlickPanel" type="PanelContainer" parent="Margin/Root/Body/LeftColumn"]
layout_mode = 2
size_flags_vertical = 3

[node name="FlickBox" type="VBoxContainer" parent="Margin/Root/Body/LeftColumn/FlickPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="FlickTitle" type="Label" parent="Margin/Root/Body/LeftColumn/FlickPanel/FlickBox"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "ANALYSE DES FLICKS · OVERFLICK / UNDERFLICK"

[node name="FlickBar" type="Control" parent="Margin/Root/Body/LeftColumn/FlickPanel/FlickBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
script = ExtResource("2_flick_bar")

[node name="FlickDetails" type="Label" parent="Margin/Root/Body/LeftColumn/FlickPanel/FlickBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
text = "—"
autowrap_mode = 3

[node name="SmoothPanel" type="PanelContainer" parent="Margin/Root/Body/LeftColumn"]
layout_mode = 2
size_flags_vertical = 3

[node name="SmoothBox" type="VBoxContainer" parent="Margin/Root/Body/LeftColumn/SmoothPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SmoothHeader" type="HBoxContainer" parent="Margin/Root/Body/LeftColumn/SmoothPanel/SmoothBox"]
layout_mode = 2

[node name="SmoothTitle" type="Label" parent="Margin/Root/Body/LeftColumn/SmoothPanel/SmoothBox/SmoothHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionLabel"
text = "INDICE DE FLUIDITÉ (SMOOTHNESS)"

[node name="SmoothValue" type="Label" parent="Margin/Root/Body/LeftColumn/SmoothPanel/SmoothBox/SmoothHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ValueLabel"
text = "— / 100"

[node name="SmoothGauge" type="ProgressBar" parent="Margin/Root/Body/LeftColumn/SmoothPanel/SmoothBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
show_percentage = false

[node name="SmoothDetails" type="Label" parent="Margin/Root/Body/LeftColumn/SmoothPanel/SmoothBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
text = "—"
autowrap_mode = 3

[node name="RightColumn" type="PanelContainer" parent="Margin/Root/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="HeatBox" type="VBoxContainer" parent="Margin/Root/Body/RightColumn"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HeatTitle" type="Label" parent="Margin/Root/Body/RightColumn/HeatBox"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "HEATMAP DES TIRS RATÉS · DISPERSION AUTOUR DE LA CIBLE"

[node name="Heatmap" type="Control" parent="Margin/Root/Body/RightColumn/HeatBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 320)
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("3_heatmap")

[node name="HeatLegend" type="Label" parent="Margin/Root/Body/RightColumn/HeatBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
text = "—"
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="FooterInfo" type="Label" parent="Margin/Root/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CaptionLabel"
text = "Télémétrie"
vertical_alignment = 1

[node name="BackButton" type="Button" parent="Margin/Root/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "MENU"

[node name="ReplayButton" type="Button" parent="Margin/Root/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "REJOUER"
