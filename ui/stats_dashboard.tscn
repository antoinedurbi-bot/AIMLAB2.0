theme_override_font_sizes/font_size = 24
text = "— / 100"

[node name="SmoothGauge" type="ProgressBar" parent="Margin/Root/Analysis/FlickPanel/FlickBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
