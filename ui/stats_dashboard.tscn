[node name="SmoothDetails" type="Label" parent="Margin/Root/Analysis/FlickPanel/FlickBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "—"
autowrap_mode = 3

[node name="HeatPanel" type="PanelContainer" parent="Margin/Root/Analysis"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="HeatBox" type="VBoxContainer" parent="Margin/Root/Analysis/HeatPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeatTitle" type="Label" parent="Margin/Root/Analysis/HeatPanel/HeatBox"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "HEATMAP DES TIRS RATÉS"

[node name="Heatmap" type="Control" parent="Margin/Root/Analysis/HeatPanel/HeatBox"]
unique_name_in_owner = true
