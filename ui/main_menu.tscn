[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://ui/crosshair.gd" id="2_crosshair"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_preview"]
bg_color = Color(0.16, 0.19, 0.24, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.02, 0.04, 0.72)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 72
theme_override_constants/margin_top = 56
theme_override_constants/margin_right = 72
theme_override_constants/margin_bottom = 56

[node name="Columns" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 56

[node name="Left" type="VBoxContainer" parent="Margin/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14
alignment = 1

[node name="Title" type="Label" parent="Margin/Columns/Left"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "KINETIC // AIM"

[node name="Tagline" type="Label" parent="Margin/Columns/Left"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "AIM TRAINER HAUTE PRÉCISION · TÉLÉMÉTRIE 1000 HZ"

[node name="Gap" type="Control" parent="Margin/Columns/Left"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="ModePanel" type="PanelContainer" parent="Margin/Columns/Left"]
layout_mode = 2

[node name="ModeBox" type="VBoxContainer" parent="Margin/Columns/Left/ModePanel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ModeCaption" type="Label" parent="Margin/Columns/Left/ModePanel/ModeBox"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "MODE DE JEU"

[node name="ModeName" type="Label" parent="Margin/Columns/Left/ModePanel/ModeBox"]
layout_mode = 2
theme_type_variation = &"ValueLabel"
text = "GRIDSHOT · 60 s"

[node name="ModeDescription" type="Label" parent="Margin/Columns/Left/ModePanel/ModeBox"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "Trois sphères lumineuses apparaissent sur une grille face à vous. Détruisez-en une : une autre surgit aussitôt ailleurs. Enchaînez les flicks le plus vite et le plus proprement possible ; chaque mouvement est enregistré puis analysé à la fin de la session."
autowrap_mode = 3

[node name="PlayButton" type="Button" parent="Margin/Columns/Left/ModePanel/ModeBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"AccentButton"
text = "LANCER LA SESSION"

[node name="Controls" type="Label" parent="Margin/Columns/Left"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Clic gauche : tirer   ·   Échap : retour au menu   ·   F11 : plein écran"

[node name="QuitButton" type="Button" parent="Margin/Columns/Left"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "QUITTER"

[node name="Right" type="PanelContainer" parent="Margin/Columns"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2

[node name="RightBox" type="VBoxContainer" parent="Margin/Columns/Right"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SettingsTitle" type="Label" parent="Margin/Columns/Right/RightBox"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "RÉGLAGES"

[node name="Scroll" type="ScrollContainer" parent="Margin/Columns/Right/RightBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="SettingsList" type="VBoxContainer" parent="Margin/Columns/Right/RightBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="PreviewCaption" type="Label" parent="Margin/Columns/Right/RightBox"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "APERÇU DU RÉTICULE"

[node name="PreviewPanel" type="Panel" parent="Margin/Columns/Right/RightBox"]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_preview")

[node name="CrosshairPreview" type="Control" parent="Margin/Columns/Right/RightBox/PreviewPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_crosshair")
